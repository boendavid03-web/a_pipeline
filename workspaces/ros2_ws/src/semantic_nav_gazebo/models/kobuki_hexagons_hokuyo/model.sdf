    <link name="wheel_left_link">
      <pose>0 0.115 0.0352 -1.5708 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.0206</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://kobuki_hexagons_hokuyo/meshes/kobuki/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose>0 -0.115 0.0352 -1.5708 0 0</pose>
      <inertial>
