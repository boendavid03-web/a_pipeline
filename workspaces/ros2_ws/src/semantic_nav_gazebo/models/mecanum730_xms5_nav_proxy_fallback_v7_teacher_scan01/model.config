<?xml version='1.0' encoding='utf-8'?>
<model>
  <name>mecanum730_xms5_nav_proxy_fallback_v7_teacher_scan01</name>
  <version>0.1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <author>
    <name>semantic_navigation</name>
  </author>
  <description>
    Clean navigation proxy for mecanum730_xms5 Semantic2D data collection.
    Adds teacher base_scan_01 and base_scan_02 2D LiDAR links.
    Publishes dual simulated LaserScan topics: /scan_01 and /scan_02.
    Uses the assembled real visual mesh, one simplified base collision,
    fixed teacher scan frames, VelocityControl, and OdometryPublisher.
    It is not a full mecanum wheel dynamics model.
  </description>
</model>
