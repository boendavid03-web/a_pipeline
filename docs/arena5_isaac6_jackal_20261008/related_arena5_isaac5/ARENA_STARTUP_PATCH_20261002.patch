+    def _set_up_isaac_goal_owner(self):
+        """Isaac owns one high-level action, never the goal_pose relay."""
+        self._isaac_generation = 0
+        self._isaac_goal_sent = False
+        self._isaac_pending_send = None
+        self._isaac_active_handle = None
+        self._isaac_active_uuid = None
+        self._isaac_retiring = {}
+        self._isaac_goal_pos = None
+        self._isaac_reset_wall = time.monotonic()
+        self._isaac_last_wait_log = 0.0
+        self._isaac_expected_start = None
+        self._isaac_reset_odom_stamp = None
+        self._isaac_reset_tf_stamp = None
+        self._isaac_last_odom_stamp = None
+        self._isaac_last_odom_arrival = None
+        self._isaac_costmap = None
+        self._isaac_costmap_arrival = None
+        self._isaac_tf_buffer = Buffer()
+        self._isaac_tf_listener = TransformListener(
+            self._isaac_tf_buffer, self.node, spin_thread=False)
+        self._isaac_action_client = ActionClient(
+            self.node, NavigateToPose, self.namespace('navigate_to_pose'))
+        self._isaac_lifecycle_names = ('bt_navigator', 'planner_server', 'controller_server')
+        self._isaac_lifecycle_clients = {
+            name: self.node.create_client(
+                GetState, self.namespace(name, 'get_state'),
+                callback_group=self.node.default_callback_group)
+            for name in self._isaac_lifecycle_names
+        }
+        self._isaac_lifecycle_futures = {}
+        self._isaac_lifecycle_active = {}
+        self.node.create_subscription(
+            nav_msgs.OccupancyGrid,
+            self.namespace('global_costmap', 'costmap'),
+            self._isaac_costmap_callback,
+            10,
+        )
+        self._isaac_goal_timer = self.node.create_timer(0.2, self._isaac_goal_tick)
+
+    @staticmethod
+    def _stamp_ns(stamp):
+        return int(stamp.sec) * 1_000_000_000 + int(stamp.nanosec)
+
+    def _isaac_robot_transform(self):
+        base_frame = str(self.frame(self._config.model_params.base_frame)).lstrip('/')
+        try:
+            return self._isaac_tf_buffer.lookup_transform('map', base_frame, Time())
+        except TransformException:
+            return None
+
+    def _isaac_costmap_callback(self, data: nav_msgs.OccupancyGrid):
+        self._isaac_costmap = data
+        self._isaac_costmap_arrival = time.monotonic()
+
+    def _isaac_query_lifecycle(self):
+        for name, client in self._isaac_lifecycle_clients.items():
+            if self._isaac_lifecycle_active.get(name) or name in self._isaac_lifecycle_futures:
+                continue
+            if not client.service_is_ready():
+                continue
+            future = client.call_async(GetState.Request())
+            self._isaac_lifecycle_futures[name] = future
+            generation = self._isaac_generation
+            future.add_done_callback(
+                lambda completed, name=name, generation=generation:
+                self._isaac_lifecycle_response(name, generation, completed))
+
+    def _isaac_lifecycle_response(self, name, generation, future):
+        if (generation != self._isaac_generation
+                or self._isaac_lifecycle_futures.get(name) is not future):
+            return
+        self._isaac_lifecycle_futures.pop(name, None)
+        try:
+            self._isaac_lifecycle_active[name] = (
+                future.result().current_state.id
+                == lifecycle_msgs.msg.State.PRIMARY_STATE_ACTIVE)
+        except Exception as exc:
+            self._isaac_lifecycle_active[name] = False
+            self._logger.warn(f'Nav2 {name} lifecycle query failed: {exc}')
+
+    def _isaac_pose_ready(self):
+        if self._isaac_last_odom_arrival is None or self._isaac_last_odom_arrival < self._isaac_reset_wall:
+            return False
+        if self._isaac_last_odom_stamp is None or self._isaac_last_odom_stamp <= 0:
+            return False
+        if (self._isaac_reset_odom_stamp is not None
+                and self._isaac_last_odom_stamp <= self._isaac_reset_odom_stamp):
+            return False
+        transform = self._isaac_robot_transform()
+        if transform is None:
+            return False
+        tf_stamp = self._stamp_ns(transform.header.stamp)
+        if tf_stamp <= 0:
+            return False
+        if self._isaac_reset_tf_stamp is not None and tf_stamp <= self._isaac_reset_tf_stamp:
+            return False
+        # TF is published at a lower rate than odom; reject a truly stale chain.
+        if self._isaac_last_odom_stamp - tf_stamp > 500_000_000:
+            return False
+        x = transform.transform.translation.x
+        y = transform.transform.translation.y
+        if not all(math.isfinite(v) for v in (
+                x, y, self._pose.position.x, self._pose.position.y)):
+            return False
+        if math.hypot(x - self._pose.position.x, y - self._pose.position.y) > 0.5:
+            return False
+        if self._isaac_expected_start is not None:
+            if math.hypot(x - self._isaac_expected_start.position.x,
+                          y - self._isaac_expected_start.position.y) > 0.5:
+                return False
+        return True
+
+    def _isaac_inside_global_costmap(self):
+        costmap = self._isaac_costmap
+        transform = self._isaac_robot_transform()
+        if (costmap is None or transform is None
+                or self._isaac_costmap_arrival is None
+                or self._isaac_costmap_arrival < self._isaac_reset_wall
+                or costmap.header.frame_id.lstrip('/') != 'map'):
+            return False
+        info = costmap.info
+        if not info.width or not info.height or not math.isfinite(info.resolution) or info.resolution <= 0:
+            return False
+        x = transform.transform.translation.x
+        y = transform.transform.translation.y
+        xmin, ymin = info.origin.position.x, info.origin.position.y
+        margin = self._robot_radius
+        return (xmin + margin <= x < xmin + info.width * info.resolution - margin
+                and ymin + margin <= y < ymin + info.height * info.resolution - margin)
+
+    def _isaac_goal_tick(self):
+        if self._isaac_goal_pos is None or self._isaac_goal_sent:
+            return
+        if self._isaac_pending_send is not None or self._isaac_active_handle is not None or self._isaac_retiring:
+            self._isaac_wait_log('prior action has not terminated')
+            return
+        self._isaac_query_lifecycle()
+        if not all(self._isaac_lifecycle_active.get(name, False)
+                   for name in self._isaac_lifecycle_names):
+            self._isaac_wait_log('Nav2 lifecycle inactive')
+            return
+        if not self._isaac_action_client.server_is_ready():
+            self._isaac_wait_log('NavigateToPose server unavailable')
+            return
+        if not self._isaac_pose_ready():
+            self._isaac_wait_log('waiting for fresh real robot odom and map TF')
+            return
+        if not self._isaac_inside_global_costmap():
+            self._isaac_wait_log('robot not inside current global costmap')
+            return
+        self._isaac_send_goal()
+
+    def _isaac_wait_log(self, reason):
+        now = time.monotonic()
+        if now - self._isaac_last_wait_log >= 10.0:
+            self._isaac_last_wait_log = now
+            self._logger.warn(
+                f'ISAAC_GOAL_WAIT generation={self._isaac_generation}: {reason}')
+
+    def _isaac_send_goal(self):
+        generation = self._isaac_generation
+        request = NavigateToPose.Goal()
+        request.pose.header.frame_id = 'map'
+        request.pose.header.stamp = self.node.get_clock().now().to_msg()
+        request.pose.pose = self._isaac_goal_pos.to_msg()
+        self._isaac_goal_sent = True
+        self._logger.warn(
+            f'ISAAC_GOAL_SEND generation={generation} '
+            f'odom_xy=({self._pose.position.x:.3f},{self._pose.position.y:.3f}) '
+            f'odom_stamp_ns={self._isaac_last_odom_stamp} '
+            f'goal_xy=({self._isaac_goal_pos.position.x:.3f},'
+            f'{self._isaac_goal_pos.position.y:.3f})')
+        try:
+            future = self._isaac_action_client.send_goal_async(request)
+        except Exception as exc:
+            self._logger.error(f'Isaac goal send failed generation={generation}: {exc}')
+            return  # sent stays true: no unclassified automatic retry
+        self._isaac_pending_send = future
+        future.add_done_callback(
+            lambda completed: self._isaac_goal_response(generation, completed))
+
+    @staticmethod
+    def _isaac_uuid(goal_handle):
+        return bytes(goal_handle.goal_id.uuid).hex()
+
+    def _isaac_goal_response(self, generation, future):
+        if self._isaac_pending_send is future:
+            self._isaac_pending_send = None
+        try:
+            handle = future.result()
+        except Exception as exc:
+            self._logger.error(f'Isaac goal response failed generation={generation}: {exc}')
+            return
+        if not handle.accepted:
+            self._logger.error(f'Isaac goal rejected generation={generation}')
+            return
+        uuid = self._isaac_uuid(handle)
+        result_future = handle.get_result_async()
+        result_future.add_done_callback(
+            lambda completed: self._isaac_goal_result(generation, uuid, completed))
+        if generation != self._isaac_generation:
+            self._isaac_retire_goal(uuid, handle)
+            return
+        self._isaac_active_handle = handle
+        self._isaac_active_uuid = uuid
+        self._goal_action_running = True
+        self._logger.warn(f'ISAAC_GOAL_ACCEPTED generation={generation} uuid={uuid}')
+
+    def _isaac_retire_goal(self, uuid, handle):
+        self._isaac_retiring[uuid] = handle
+        self._logger.info(f'Isaac goal cancel old uuid={uuid}')
+        try:
+            future = handle.cancel_goal_async()
+            future.add_done_callback(
+                lambda completed: self._isaac_cancel_response(uuid, completed))
+        except Exception as exc:
+            self._logger.error(f'Isaac goal cancel request failed uuid={uuid}: {exc}')
+
+    def _isaac_cancel_response(self, uuid, future):
+        try:
+            response = future.result()
+            if not response.goals_canceling:
+                self._logger.warn(f'Isaac goal cancel not accepted uuid={uuid}; awaiting terminal result')
+        except Exception as exc:
+            self._logger.error(f'Isaac goal cancel response failed uuid={uuid}: {exc}')
+
+    def _isaac_goal_result(self, generation, uuid, future):
+        self._isaac_retiring.pop(uuid, None)
+        if generation != self._isaac_generation or uuid != self._isaac_active_uuid:
+            self._logger.info(f'Ignoring stale Isaac goal result generation={generation} uuid={uuid}')
+            return
+        self._isaac_active_handle = None
+        self._isaac_active_uuid = None
+        self._goal_action_running = False
+        try:
+            status = future.result().status
+        except Exception as exc:
+            self._logger.error(f'Isaac goal result failed generation={generation} uuid={uuid}: {exc}')
+            return
+        self._is_goal_reached = status == action_msgs.msg.GoalStatus.STATUS_SUCCEEDED
+        self._logger.warn(
+            f'ISAAC_GOAL_TERMINAL generation={generation} uuid={uuid} status={status}')
 
