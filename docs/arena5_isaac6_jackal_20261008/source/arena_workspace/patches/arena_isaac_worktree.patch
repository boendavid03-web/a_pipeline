+def ensure_static_obstacle_colliders(root: Usd.Prim) -> None:
+    """Supply static mesh collision only for collider-free env obstacle assets.
+
+    Preserve authored collision (including intentionally disabled collision),
+    and leave decorative wall assets and imported whole worlds unchanged.
+    """
+    parent = root.GetParent()
+    env_name = parent.GetParent().GetName()
+    if parent.GetName() != 'Obstacles' or not env_name.startswith('env_') or not env_name[4:].isdigit():
+        return
+    subtree = list(Usd.PrimRange(root))
+    if any(p.HasAPI(UsdPhysics.CollisionAPI) for p in subtree):
+        return
+    for mesh in subtree:
+        if mesh.IsA(UsdGeom.Mesh):
+            UsdPhysics.CollisionAPI.Apply(mesh).CreateCollisionEnabledAttr(True)
+            UsdPhysics.MeshCollisionAPI.Apply(mesh).CreateApproximationAttr('none')
+
+
 @on_exception(False)
