index 28ac861..5706fc0 100644
--- a/arena_humansim/tests/ros/test_world_state_ingest.py
+++ b/arena_humansim/tests/ros/test_world_state_ingest.py
@@ -269,3 +269,70 @@ def test_ghost_spawn_unchanged_alongside_bound_agent(system: RosTestSystem) -> N
     published = {a.agent_id for a in manager._build_agent_states_msg().agents}
     assert ped_aid in published
     assert ghost.agent_id not in published
+
+
+@pytest.mark.parametrize('registered', [False, True])
+@pytest.mark.parametrize('local_planner', ['sfm', 'hsfm', 'straight', 'socialgail', 'nsp'])
+def test_external_robot_velocity_reaches_pool_and_planner(system: RosTestSystem, registered: bool, local_planner: str) -> None:
+    manager = system.manager
+    previous = manager.get_parameter('local_planner').value
+    manager._select_local_planner(local_planner)
+    if registered:
+        _spawn_robot(system, 3.0, 0.0)
+    resp = system.call(SpawnAgents, 'spawn_agents', make_spawn_request([{'x': 0.0, 'y': 0.0}]))
+    ped_aid = resp.spawned_ids[0]
+    msg = _world_state([(_EXT_ID, 3.0, 0.0, 0.2, 0.3)])
+    msg.agents[0].velocity = Vector3(x=0.8, y=-0.2, z=0.0)
+    seen = []
+    planner = manager._local_planner
+    compute = planner.compute_pool
+    def observe(pool, *args, **kwargs):
+        aid = manager._external_entities[_EXT_ID].agent_id
+        seen.append(pool.vel[pool.idx(aid)].copy())
+        return compute(pool, *args, **kwargs)
+    planner.compute_pool = observe
+    try:
+        manager._world_state_callback(msg)
+        system.tick_manager(1)
+        entity = manager._external_entities[_EXT_ID]
+        idx = manager._pool.idx(entity.agent_id)
+        assert entity.vel == (0.8, -0.2)
+        assert seen and tuple(seen[-1]) == pytest.approx((0.8, -0.2))
+        assert tuple(manager._pool.vel[idx]) == pytest.approx((0.8, -0.2))
+        assert tuple(manager._pool.pos[idx]) == pytest.approx((3.0, 0.0))
+        assert manager._pool.theta[idx] == pytest.approx(0.2)
+        assert entity.agent_id in manager._pool.visible_agent_ids(ped_aid)
+    finally:
+        planner.compute_pool = compute
+        manager._select_local_planner(previous)
+
+
+@pytest.mark.parametrize('registered', [False, True])
+def test_orca_receives_authoritative_external_robot(system: RosTestSystem, registered: bool) -> None:
+    manager = system.manager
+    previous = manager.get_parameter('local_planner').value
+    manager._select_local_planner('orca')
+    if registered:
+        _spawn_robot(system, 3.0, 0.0)
+    resp = system.call(SpawnAgents, 'spawn_agents', make_spawn_request([{'x': 0.0, 'y': 0.0}]))
+    ped = resp.spawned_ids[0]
+    seen = []
+    planner = manager._local_planner
+    compute = planner.compute
+    def observe(agents, *args, **kwargs):
+        seen.append({a.state.agent_id: (a.state.pose.x, a.state.pose.y, *a.state.velocity) for a in agents})
+        return compute(agents, *args, **kwargs)
+    planner.compute = observe
+    try:
+        msg = _world_state([(_EXT_ID, 3.0, 0.0, 0.2, 0.3)])
+        msg.agents[0].velocity = Vector3(x=0.8, y=-0.2)
+        manager._world_state_callback(msg)
+        system.tick_manager(1)
+        robot = manager._external_entities[_EXT_ID].agent_id
+        assert seen and ped in seen[-1]
+        assert robot in seen[-1]
+        assert seen[-1][robot] == pytest.approx((3.0, 0.0, 0.8, -0.2))
+        assert tuple(manager._pool.pos[manager._pool.idx(robot)]) == pytest.approx((3.0, 0.0))
+    finally:
+        planner.compute = compute
+        manager._select_local_planner(previous)
