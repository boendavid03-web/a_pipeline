diff --git a/arena_robots/tests/ros/test_goto_pose_nav2.py b/arena_robots/tests/ros/test_goto_pose_nav2.py
index 17c93c8..a12e106 100644
--- a/arena_robots/tests/ros/test_goto_pose_nav2.py
+++ b/arena_robots/tests/ros/test_goto_pose_nav2.py
@@ -314,3 +314,35 @@ class TestGotoPoseHandlerNav2Execute:
         goal_handle = self._make_goal_handle()
         result = asyncio.run(handler.execute(goal_handle))
         assert isinstance(result.final_pose, PoseStamped)
+
+
+@pytest.mark.parametrize("during_send", [False, True])
+def test_cancel_reaches_pending_native_nav2_goal(during_send):
+    from action_msgs.msg import GoalStatus
+    from arena_robots_msgs.action import GotoPose
+
+    helper = TestGotoPoseHandlerNav2Execute()
+    handler = helper._make_handler()
+    goal_handle = helper._make_goal_handle()
+    native_goal = MagicMock(accepted=True)
+    native_goal.cancel_goal_async = MagicMock()
+
+    async def send(*args, **kwargs):
+        if during_send:
+            goal_handle.is_cancel_requested = True
+        return native_goal
+
+    async def terminal():
+        if not during_send:
+            goal_handle.is_cancel_requested = True
+            handler.on_cancel(goal_handle)
+        assert native_goal.cancel_goal_async.called, "Cancel must reach the executing native goal"
+        return SimpleNamespace(status=GoalStatus.STATUS_CANCELED, result=None)
+
+    native_goal.get_result_async = terminal
+    handler._native_client.server_is_ready.return_value = True
+    handler._native_client.send_goal_async = send
+    result = asyncio.run(handler.execute(goal_handle))
+    assert result.status == GotoPose.Result.STATUS_CANCELED
+    goal_handle.canceled.assert_called_once()
+    assert not handler._native_goals
